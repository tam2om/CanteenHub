{
  "name": "canteenhub",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "db:migrate": "wrangler d1 migrations apply canteenhub-local --local",
    "db:migrate:prod": "wrangler d1 migrations apply canteenhub-prod --env production --remote",
    "dev": "vite",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "worker:deploy": "wrangler deploy",
    "worker:deploy:prod": "npm run build && wrangler deploy --env production",
    "worker:dev": "wrangler dev"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.102.8",
    "hono": "^4.13.7",
    "jose": "^6.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/ui": "^4.1.11",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "jsdom": "^29.1.1",
    "typescript": "~5.8.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.86.0"
  }
}
